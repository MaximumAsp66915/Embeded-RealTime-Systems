\relax 
\providecommand\hyper@newdestlabel[2]{}
\@writefile{toc}{\contentsline {section}{smartsection}{2}{section*.1}\protected@file@percent }
\newlabel{sec:smartsection}{{}{2}{}{section*.1}{}}
\newlabel{sec:smartsection@cref}{{}{[1][2][]2}}
\@writefile{toc}{\contentsline {subsection}{smartsubsection}{2}{section*.2}\protected@file@percent }
\newlabel{subsec:smartsubsection}{{}{2}{}{section*.2}{}}
\newlabel{subsec:smartsubsection@cref}{{}{[1][2][]2}}
\@writefile{toc}{\contentsline {subsubsection}{smartsubsubsection}{2}{section*.3}\protected@file@percent }
\newlabel{subsubsec:smartsubsubsection}{{}{2}{}{section*.3}{}}
\newlabel{subsubsec:smartsubsubsection@cref}{{}{[1][2][]2}}
\newlabel{q:questionsection's-name}{{1}{2}{}{section.1}{}}
\newlabel{q:questionsection's-name@cref}{{[section][1][]1}{[1][2][]2}}
\@writefile{toc}{\contentsline {subsection}{Question~questionsection's name}{2}{section.1}\protected@file@percent }
\newlabel{a:answersection's-name}{{}{2}{}{section.1}{}}
\newlabel{a:answersection's-name@cref}{{}{[1][2][]2}}
\@writefile{lol}{\contentsline {lstlisting}{\numberline {1}{\ignorespaces caption's text}}{2}{lstlisting.1}\protected@file@percent }
\@writefile{lol}{\contentsline {lstlisting}{\numberline {2}{\ignorespaces caption's text}}{2}{lstlisting.2}\protected@file@percent }
\@writefile{lol}{\contentsline {lstlisting}{\numberline {3}{\ignorespaces caption's text}}{2}{lstlisting.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces caption}}{2}{figure.caption.4}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:file_name}{{1}{2}{caption}{figure.caption.4}{}}
\newlabel{fig:file_name@cref}{{[figure][1][]1}{[1][2][]2}}
